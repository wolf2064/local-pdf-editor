{
  "manifest_version": 3,
  "name": "ローカルPDFエディター（文字・図形・注釈・ページ編集）",
  "short_name": "PDFエディター",
  "version": "4.8.0",
  "description": "PCのPDFをブラウザーでそのまま編集。PDF内の文字の書き換え、図形の移動・拡大縮小・色変更、注釈やスタンプの追加、ページの整理、印刷ができます。",
  "permissions": [
    "webNavigation",
    "storage",
    "clipboardRead",
    "downloads"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PDFエディターを開く（表示中のローカルPDFを編集）",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
